+        assert len(depot.enregistrements) == 1
+        assert depot.fin["statut"] == TestExecutionStatus.COMPLETED
+        assert "images de page absentes : [1]" in depot.fin["message"]
+        assert depot.fin["agregats"][1].compared == 1

# Environnements
# Valeurs : dev | staging | prod
APP_ENV=dev
APP_NAME=NOTA
APP_VERSION=0.1.0

# BDD
POSTGRES_USER=postgres
POSTGRES_DB=nota_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_PASSWORD=postgres
# DATABASE_URL=postgresql+asyncpg://nota:nota_dev_password@localhost:5432/nota_db

# API FastAPI 
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1
API_TITLE="NOTA API"
API_VERSION=v1
API_CORS_ORIGINS=http://localhost:4200,http://localhost:8000

# Auth
API_DISABLE_JWT_VALIDATION=false
API_DEV_MATRICULE=MAT00001

# Secret JWT
JWT_SECRET_KEY=changeme_use_a_strong_random_secret_in_prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# API Key
INTERNAL_AUTH_ENABLED=false
INTERNAL_API_KEY=nota_dev_internal_key_32chars_min

# En production : PIE_CONFIG_FILE=

# Matricule endosse quand API_DISABLE_JWT_VALIDATION=true. Doit exister dans la
# table user : le perimetre observe est celui de cette personne, resolu en base.

PIE_CONFIG_FILE=conf/pie.yaml

# Stockage fichiers (PVC)
PVC_MOUNT_PATH=./data/pvc

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=text

# OCR
OCR_MOCK_ENABLED=true
OCR_MOCK_CONFIDENCE=0.95
OCR_TIMEOUT_SECONDS=30

# Connecteur Mistral (utilise quand OCR_MOCK_ENABLED=false)
# La cle ne doit JAMAIS apparaitre dans le code ni dans un commit.
MISTRAL_API_KEY=
# URL de base AVEC protocole et sans /v1 (le connecteur ajoute /v1/ocr) : https://hote:port
MISTRAL_OCR_ENDPOINT=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_ANNOTATION_MODEL=mistral-medium-latest
# Truststore PEM pour endpoint prive (ex: https.truststore.pem) ; vide = CA systeme
MISTRAL_CA_BUNDLE=
# Annuaire Active Directory (affectation d'une personne a un projet avant sa
# premiere connexion). Desactive par defaut. Le mot de passe du compte de service
# ne doit JAMAIS apparaitre dans le code ni dans un commit.
AD_ENABLED=false
AD_HOST=
AD_PORT=636
AD_USE_SSL=true
AD_BIND_DN=
AD_PASSWORD=
AD_BASE_DN=
# Truststore PEM pour verifier le certificat de l'AD ; vide = CA systeme
AD_CA_BUNDLE=
AD_TIMEOUT_SECONDS=5
AD_SEARCH_LIMIT=25
# Une saisie plus courte ramenerait des milliers de comptes
AD_MIN_CHARS=3
# Une recherche au plus toutes les N secondes par utilisateur
AD_RATE_SECONDS=2.0
# Comptes a ne jamais proposer, separes par des virgules
# (debuts de matricule, fins de matricule, unites d'organisation)
AD_EXCLUDE_PREFIXES=
AD_EXCLUDE_SUFFIXES=
AD_EXCLUDE_OUS=

# Organisation des agents crees a leur premiere connexion (GET /users/me) quand
# leur departement AD ne designe aucune organisation : son slug, ex. BDF.
AD_ORGANISATION_DEFAUT=

# ---------------------------------------------------------------------------
# Les valeurs ci-dessous sont celles du developpement local. Les secrets
# (mots de passe, cles) ne doivent JAMAIS apparaitre dans le code ni dans un
# commit : en production ils viennent du Vault (voir SETUP.md).
# Reglages modifiables a chaud (ocr_enabled, delais des workers ; ad_enabled s'ajoute a AD_ENABLED) :
# pas ici, dans la table app_setting.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Valeurs : dev | staging | prod
APP_ENV=dev
APP_NAME=NOTA
APP_VERSION=0.1.0
LOG_LEVEL=DEBUG
LOG_FORMAT=text
# Stockage fichiers (PVC)
PVC_MOUNT_PATH=./data/pvc

# --- Base de donnees --------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nota_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://nota:nota_dev_password@localhost:5432/nota_db

# Compte DDL utilise par la migration Alembic (`launcher.py migrate`, lancee aussi par
# `launcher.py all` avant l'API et les workers). Vide : POSTGRES_USER / POSTGRES_PASSWORD.
# En production : MIGRATION_* = compte administrateur, POSTGRES_* = compte web (DML seul).
# MIGRATION_POSTGRES_USER=
# MIGRATION_POSTGRES_PASSWORD=

# Pool de connexions, par processus (api, worker). Budget total =
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) x processus x replicas, a garder sous max_connections
# du serveur : la base est partagee entre applications. Valeurs par defaut ci-dessous.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800

# --- API FastAPI ------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_TITLE="NOTA API"
API_VERSION=v1
API_CORS_ORIGINS=http://localhost:4200,http://localhost:8000

# --- Authentification -------------------------------------------------------
API_DISABLE_JWT_VALIDATION=false
# Matricule endosse quand API_DISABLE_JWT_VALIDATION=true. Doit exister dans la
# table user : le perimetre observe est celui de cette personne, resolu en base.
API_DEV_MATRICULE=MAT00001

# Authentification des services (workers, scripts) par X-Internal-Token
INTERNAL_AUTH_ENABLED=false
INTERNAL_API_KEY=nota_dev_internal_key_32chars_min

# Filtre d'URI par groupes AD ; en production, fichier propre au deploiement
PIE_CONFIG_FILE=conf/pie.yaml

# --- OCR --------------------------------------------------------------------
OCR_MOCK_ENABLED=true
OCR_MOCK_CONFIDENCE=0.95
OCR_TIMEOUT_SECONDS=30
# Pages d'un document lues en parallele par le connecteur Mistral (1 a 16 ; 1 = sequentiel).
# Le moteur repond 429 au-dela de son plafond de debit : le connecteur rejoue alors la requete.
OCR_PAGE_CONCURRENCY=3

# Connecteur Mistral (utilise quand OCR_MOCK_ENABLED=false)
MISTRAL_API_KEY=
# URL de base AVEC protocole et sans /v1 (le connecteur ajoute /v1/ocr) : https://hote:port
MISTRAL_OCR_ENDPOINT=
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_ANNOTATION_MODEL=mistral-medium-latest
# Truststore PEM pour endpoint prive (ex: https.truststore.pem) ; vide = CA systeme
MISTRAL_CA_BUNDLE=

# --- Annuaire Active Directory ----------------------------------------------
# Affectation d'une personne a un projet avant sa premiere connexion.
# Actif si AD_ENABLED est vrai OU si la cle `ad_enabled` de app_setting l'est : la variable
# force l'annuaire, le reglage en base permet de l'allumer a chaud.
AD_ENABLED=false
AD_HOST=
AD_PORT=636
AD_USE_SSL=true
AD_BIND_DN=
AD_PASSWORD=
AD_BASE_DN=
# Truststore PEM pour verifier le certificat de l'AD ; vide = CA systeme
AD_CA_BUNDLE=
AD_TIMEOUT_SECONDS=5
AD_SEARCH_LIMIT=25
# Une saisie plus courte ramenerait des milliers de comptes
AD_MIN_CHARS=3
# Une recherche au plus toutes les N secondes par utilisateur
AD_RATE_SECONDS=2.0
# Comptes a ne jamais proposer, separes par des virgules
# (debuts de matricule, fins de matricule, unites d'organisation)
AD_EXCLUDE_PREFIXES=
AD_EXCLUDE_SUFFIXES=
AD_EXCLUDE_OUS=

# Organisation des agents crees a leur premiere connexion (GET /users/me) quand
# leur departement AD ne designe aucune organisation : son slug, ex. BDF.
AD_ORGANISATION_DEFAUT=

# --- Benchmark des moteurs OCR ----------------------------------------------
# Cle du HMAC des valeurs lues sur les champs sensibles (IBAN, NIR) dans les ecarts.
# Sans elle, le benchmark refuse de tourner (le reste de l'application demarre).
# Valeur propre a chaque environnement, jamais en commit.
# Generer : python -c "import secrets; print(secrets.token_hex(32))"
COMPARISON_HMAC_KEY=
